# ============================================
# 🌐 UNIVERSAL NODE/NEST-LIKE BACKEND TEMPLATE
# Mission 5 — Clean & Professional Gitignore
# ============================================

# ─────────────────────────────────────────────
# 🔥 ENVIRONMENT FILES (never commit)
# ─────────────────────────────────────────────
.env
.env.test
.env.docker

# Example envs SHOULD be committed
# (keep these available as templates)
!.env.example
!.env.test.example


# ─────────────────────────────────────────────
# 📦 DEPENDENCIES
# ─────────────────────────────────────────────
node_modules/


# ─────────────────────────────────────────────
# 🛠️ BUILD AND CACHE ARTIFACTS
# ─────────────────────────────────────────────
dist/
build/
coverage/
.cache/
.nyc_output/
*.tsbuildinfo


# ─────────────────────────────────────────────
# 🪵 LOG FILES (runtime output)
# ─────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ─────────────────────────────────────────────
# 🔨 PRISMA GENERATED CLIENT (safe to keep ignored)
# ─────────────────────────────────────────────
generated/
!generated/prisma/schema.prisma  # keep schema if needed


# ─────────────────────────────────────────────
# 🐳 DOCKER ARTIFACTS (if ever used)
# ─────────────────────────────────────────────
*.pid
*.seed


# ─────────────────────────────────────────────
# 🧪 JEST
# ─────────────────────────────────────────────
jest-test-results.json
jest-cache/
.tmp/


# ─────────────────────────────────────────────
# ⚠️ EDITOR / SYSTEM FILES
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp


# ─────────────────────────────────────────────
# 🧩 HUSKY (DO commit!)
# OBS: .husky/ deve IR para o GitHub. Não ignore.
# ─────────────────────────────────────────────
# (nenhuma linha aqui — apenas lembrete)


# ─────────────────────────────────────────────
# 🧠 PROJECT INTERNALS (keep these)
# DON'T IGNORE:
#   .COMMANDS
#   terminalStylization/
#   prisma/migrations/
#   middlewares/
# ─────────────────────────────────────────────

